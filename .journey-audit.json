{
  "name": "TeInformez",
  "baseUrl": "https://teinformez.eu",
  "login": {
    "path": "/login",
    "emailSelector": "input[type=email]",
    "passwordSelector": "input[type=password]",
    "submitSelector": "button[type=submit]",
    "successUrlPattern": "/(dashboard|onboarding|$)"
  },
  "credentials": {
    "emailEnv": "JOURNEY_EMAIL",
    "passwordEnv": "JOURNEY_PASSWORD"
  },
  "startUrl": "https://legal.knowbest.ro",
  "navLinks": [
    { "name": "Legal Hub", "href": "https://legal.knowbest.ro" },
    { "name": "Legal Hub DSR", "href": "https://legal.knowbest.ro/dsr" },
    { "name": "Legal Hub Privacy", "href": "https://legal.knowbest.ro/privacy" },
    { "name": "Legal Hub Health", "href": "/api/legal-hub/health" },
    { "name": "Legal Privacy Version API", "href": "/wp-json/teinformez/v1/legal/privacy-version" },
    { "name": "GDPR", "href": "/gdpr" },
    { "name": "Privacy", "href": "/privacy" },
    { "name": "Terms", "href": "/terms" },
    { "name": "Home", "href": "/" },
    { "name": "Dashboard", "href": "/dashboard" },
    { "name": "Profil", "href": "/profile" },
    { "name": "Setari", "href": "/settings" }
  ],
  "apiTests": [
    {
      "name": "DSR email trim + description cap",
      "url": "/wp-json/teinformez/v1/legal/dsr",
      "method": "POST",
      "body": { "name": "Test User", "email": " test@example.com ", "type": "ACCESS", "description": "" },
      "expectFields": ["requestId", "originalType"],
      "expectStatus": 200
    },
    {
      "name": "Consent record GDPR guard — missing documentVersionId",
      "url": "/api/consent/record",
      "method": "POST",
      "body": { "consentText": "Am citit politica.", "userId": "test-123" },
      "expectStatus": 400
    }
  ],
  "onboardingMarkers": "Alege categorii|selecteaza|interese|onboarding|preferences",
  "emptyStateMarkers": "Nu exista|nicio stire|empty|no results|Niciun",
  "errorMarkers": "error|eroare|failed|esuat|500|crash",
  "viewport": { "width": 1440, "height": 900 },
  "pageTimeout": 25000,
  "settleDelay": 2000
}
